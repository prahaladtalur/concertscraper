# ---- Required: Ticketmaster Discovery API (free) --------------------------
# Register at https://developer.ticketmaster.com/ and create an app.
TICKETMASTER_API_KEY=

# ---- Optional: Spotify, for the artist-demand signal ----------------------
# https://developer.spotify.com/dashboard  (client credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Markets ---------------------------------------------------------------
# Ticketmaster DMA ids, comma separated. 324=Seattle-Tacoma, 345=New York,
# 324,382 etc. Full list: https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/#dma
MARKET_DMA_IDS=324
CLASSIFICATION_NAME=Music
LOOKAHEAD_DAYS=240

# ---- Polling ---------------------------------------------------------------
# Ticketmaster allows 5000 requests/day. 180 min keeps you well inside it.
POLL_INTERVAL_MINUTES=180
REQUESTS_PER_SECOND=4

# ---- Alerting --------------------------------------------------------------
ALERT_SCORE_THRESHOLD=0.62
ALERT_COOLDOWN_HOURS=48
MAX_ALERTS_PER_EMAIL=12

# Leave EMAIL_DRY_RUN=true to write digests to ./outbox/ instead of sending.
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=

# ---- Portfolio tracking ----------------------------------------------------
# Hour (UTC) for the daily mark-to-market report on tickets you bought.
DAILY_REPORT_HOUR_UTC=15
# Text/email you when a position moves more than this in a day (0.15 = 15%).
POSITION_MOVE_ALERT_PCT=0.15
# Send the daily summary by SMS every day, not just on big moves.
SMS_DAILY_SUMMARY=false

# ---- SMS via Twilio (optional) --------------------------------------------
# https://console.twilio.com/  — leave blank to use email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO=

# ---- AXS (off by default; read docs/SOURCES.md first) ---------------------
ENABLE_AXS=false

DATABASE_URL=sqlite:///./concertscraper.db
